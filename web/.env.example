# API base path. Defaults to "/api" (same-origin: dev proxy or Laravel public/).
# Set to a full URL (e.g. https://api.example.com/api) only for cross-origin hosting.
VITE_API_BASE_URL=/api

# Dev-only: where the Vite proxy forwards /api requests. Defaults to http://localhost:8000.
VITE_API_PROXY=http://localhost:8000
